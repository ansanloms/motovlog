node_modules
dist
build
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# APM dependencies
apm_modules/

# ADR-0020: 素材は既定でコミットしない。
# projects/ は Remotion の public dir で、timeline.ts と素材が同居する。
# projects/<slug>/assets/ (動画固有の素材) と、projects/common/ 配下の種別ディレクトリ
# (bgm・se・characters/<name> 等) の中身を除外する。
# 再配布できる自作素材をコミットするときは、このファイルの末尾 (下の除外パターンより後) に
# 否定パターンを追記する。前に書くと効かない。書式は次の 3 つ:
#   ファイル 1 つ:            !projects/common/se/click.wav
#   ディレクトリ丸ごと:       !projects/common/characters/aoyama/**
#   種別より深い階層のファイル: 親ディレクトリを先に戻してからファイルを書く
#                             (!projects/common/bgm/album  の次の行に  !projects/common/bgm/album/x.wav)
# 除外済みのディレクトリの下にあるファイルは、親を戻さない限りどこに書いても効かない。
# ディレクトリ丸ごと戻した配下はすべて追跡されるので、その中に第三者の素材を混ぜない。
# .gitkeep は種別ディレクトリ (characters/<name> を含む) までの placeholder。
projects/*/assets/
projects/common/*
!projects/common/*/
projects/common/*/*
!projects/common/characters/*/
projects/common/characters/*/*
!.gitkeep
# ここから下に、コミットする自作素材の否定パターンを追記する。
# サンプルの立ち絵 (characters/sample.ts の placeholder)。テンプレートに同梱する自作素材。
!projects/common/characters/sample/**
